# Laptop-only additions, sourced after common/bash/bashrc.common.

vterm_prompt_end() {
    printf "\e]51;A$(whoami)@$(hostname):$(pwd)\e\\";
}
PS1=$PS1'\[$(vterm_prompt_end)\]'

PATH=$PATH:/home/john/Scripts:/home/john/.local/bin:/home/john/packages/vault

alias dl="/home/john/Scripts/yt-dlp-wrapper.sh"
alias dl-audio="yt-dlp --format m4a/bestaudio --extract-audio --audio-format mp3"
alias dl-tor="yt-dlp --proxy socks5://localhost:9050"
alias dl-jumpbox="yt-dlp --proxy socks5://localhost:9051"
alias curl-tor="curl --proxy socks5://localhost:9050"
alias jumpbox-dl="rs jumpbox:/var/lib/transmission/Downloads/* ."
alias kodi-update="ssh pi-master-tv 'kodi-send --action=\"UpdateLibrary(video)\"'"
alias record-audio="ffmpeg -f pulse -i alsa_input.usb-C-Media_Electronics_Inc._USB_Audio_Device-00.mono-fallback out.wav"

# pass-auto-backed: unattended automation store (~/.password-store-auto,
# passphrase-protected key in ~/.gnupg-auto, primed at Hyprland login),
# separate from the interactive ~/.password-store passff/browserpass use
# for bank et al. Laptop-only for now.
#
# VAULT_TOKEN/VAULT_ADDR used to be exported here on every shell open,
# which also meant every Claude Code Bash subprocess inherited the vault
# token whether or not it ever touched vault. That's now resolved lazily,
# at call time, by ~/.local/bin/vault and ~/.local/bin/bao (see
# common/pass/vault-wrapper) shadowing the real binaries in
# /home/john/packages/vault. gpg-agent's own cache (8h) is what avoids
# re-prompting on repeat calls, not anything in this file.
#
# JIRA_CLIENT_ID/SECRET had the same problem and no binary to shadow --
# jira-trait skills read the vars directly, there's no CLI in the loop.
# Load on demand instead of at shell start:
jira-env() {
    export JIRA_CLIENT_ID=$(pass-auto show ifd-jira/client_id)
    export JIRA_CLIENT_SECRET=$(pass-auto show ifd-jira/client_secret)
}

export IFD_FLEET_ROOT=/mnt/crypt/john/projects/the-commodore
