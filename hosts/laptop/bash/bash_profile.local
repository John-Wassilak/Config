# Laptop-only additions, sourced after common/bash/bash_profile.common.

if [ -d /usr/sbin ] ; then
    pathappend /usr/sbin
fi

if [ -d "$HOME/Scripts" ] ; then
    pathprepend "$HOME/Scripts"
fi

# These three used to be one raw `PATH=$PATH:...` assignment in
# bashrc.local. That ran in *every* interactive shell with no dedup, so each
# nested shell appended another copy -- three terminals deep left four copies
# of ~/Scripts on PATH, which was also already prepended just above. The
# path helpers call pathremove first, so re-running them is idempotent.
#
# ~/.local/bin is prepended, not appended, so anything installed here wins
# over a distro copy of the same name. It used to hold vault/bao shims that
# set VAULT_ADDR; that address now comes from common/bash/bashrc.common.
if [ -d "$HOME/.local/bin" ] ; then
    pathprepend "$HOME/.local/bin"
fi

# The real vault/openbao binaries the shims above exec.
if [ -d "$HOME/packages/vault" ] ; then
    pathappend "$HOME/packages/vault"
fi

# Unlock/mount /mnt/crypt at console login, before Hyprland starts. The LUKS
# passphrase has to be typed, so this needs a tty -- an exec-once in
# hyprland.lua has none and would fail silently. Console login shells only:
# ssh and the nested shells terminals start are skipped by the tty test.
case "$(tty)" in
    /dev/tty[0-9]*)
        if [ -z "${SSH_CONNECTION:-}" ]; then
            "$HOME/Scripts/mount-crypt.sh"
        fi
        ;;
esac
