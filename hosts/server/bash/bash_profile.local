# Server-only additions, sourced after common/bash/bash_profile.common.

if [ -d "$HOME/Scripts" ] ; then
    pathprepend "$HOME/Scripts"
fi

# Prepended rather than appended so anything installed here wins over a
# distro copy of the same name. Holds pass-auto and feedgen; it used to
# hold a bao shim that set VAULT_ADDR, which is now exported from
# common/bash/bashrc.common instead.
if [ -d "$HOME/.local/bin" ] ; then
    pathprepend "$HOME/.local/bin"
fi

# 'first' login on the physical console: mount the encrypted volume and
# bring up the firewall before anything else runs.
if [ -z "${DISPLAY}" ] && [ "$(tty)" = "/dev/tty1" ]; then
    "$HOME/Scripts/mount-crypt.sh"
    "$HOME/Scripts/firewall.sh"
    eval "$(ssh-agent)" > /dev/null
    ssh-add
fi

# LFS's /etc/profile appends /usr/sbin for root only, so as john the
# iproute2 tools are on disk but off PATH. That turns the tunnel
# verification step in the RCE foundation-db SOP -- `ss -tlnp | grep 14330`
# -- into "ss: command not found", which greps to nothing and reads as a
# dead tunnel rather than a missing binary. ss, ip and friends work fine
# unprivileged for our own sockets. Appended, not prepended, so a
# user-installed tool of the same name still wins. /sbin is a symlink to
# usr/sbin here, so it needs no separate entry -- same test /etc/profile uses.
if [ -d /usr/sbin ] ; then
    pathappend /usr/sbin
fi
if [ -d /sbin ] && [ ! -L /sbin ] ; then
    pathappend /sbin
fi
