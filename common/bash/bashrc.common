# Sourced by every host's ~/.bashrc. Host-specific env/aliases live in
# hosts/<host>/bash/bashrc.local, sourced after this file.

# OpenBao/Vault address. Set before the interactivity check below so
# non-interactive shells (scripts, cron) get it too. Neither the vault nor
# the bao binary has a default beyond https://127.0.0.1:8200, so leaving
# this unset silently points every call at localhost.
#
# This replaces the common/pass/vault-wrapper PATH shim, which set the
# address by shadowing the binary and only worked in login shells. No token
# is set here on purpose: `bao login -method=oidc` caches a short-lived one
# to ~/.vault-token (0600) and the CLI reads it from there, so it never
# enters the environment of every child process.
export VAULT_ADDR="${VAULT_ADDR:-http://ifd-vault:8200}"
export BAO_ADDR="${BAO_ADDR:-$VAULT_ADDR}"

if [[ $- != *i* ]] ; then
    return
fi

# System-wide aliases/prompt (PS1, ls/grep colors, dircolors on
# BLFS/LFS hosts). Was unconditional in the pre-restructure ~/.bashrc;
# dropping it here broke the prompt on hosts/server.
if [ -f "/etc/bashrc" ] ; then
    source /etc/bashrc
fi

# Same prompt shape /etc/bashrc sets, with the host added: "john@laptop [ ~ ]$".
# Set after that source so it wins, and before bashrc.local so the laptop's
# vterm_prompt_end still appends cleanly. Every host gets it -- laptop and
# server prompts were indistinguishable over ssh.
if [[ $EUID == 0 ]] ; then
    PS1="\[\e[1;31m\]\u@\h [ \[\e[0m\]\w\[\e[1;31m\] ]# \[\e[0m\]"
else
    PS1="\[\e[1;32m\]\u@\h [ \[\e[0m\]\w\[\e[1;32m\] ]\$ \[\e[0m\]"
fi

# needed by pinentry-curses so gpg-agent can find the terminal
export GPG_TTY=$(tty)

alias rm="rm -i"
alias mv="mv -i"
alias cp="cp -i"
alias rs="rsync -avzP"
alias pwgen="tr -dc 'A-Za-z0-9!@#$%^&*()_+-={}[]|:;\",.<>?/' < /dev/urandom | head -c 30; echo"
alias danger-claude="claude --dangerously-skip-permissions"

export JIRA_BASE_URL="https://infocusdata.atlassian.net"
export JIRA_REDIRECT_URI=http://localhost:9876/callback

# ssh-agent: one shared agent per node on a fixed socket; prompts for the key
# passphrase at interactive shell open only. See common/ssh/agent-bootstrap.sh.
if [ -r "$HOME/.ssh/agent-bootstrap.sh" ]; then
    source "$HOME/.ssh/agent-bootstrap.sh"
fi
