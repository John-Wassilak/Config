#!/bin/bash
# Lazy VAULT_ADDR/VAULT_TOKEN shim for the vault/openbao CLI. Symlinked as
# ~/.local/bin/vault and/or ~/.local/bin/bao, which shadow the real binary
# on PATH (.local/bin is prepended ahead of it).
#
# It exists for two reasons:
#
#   1. The server address. Neither binary has a compiled-in default beyond
#      https://127.0.0.1:8200, so an unset VAULT_ADDR/BAO_ADDR silently
#      points every call at localhost. Setting it here means it is set on
#      every host that links the shim, not just the ones whose bashrc
#      happens to export it.
#   2. The token, lazily. bashrc.local used to export VAULT_TOKEN on every
#      shell open, which also meant every Claude Code Bash subprocess
#      inherited it whether or not that session ever touched vault.
#      Resolving it here moves the pass-auto call from shell-start to
#      call-time, so the pinentry only appears if this shim actually runs
#      and gpg-agent's cache has expired.
#
# No TTL logic lives here on purpose: pass-auto's own gpg-agent cache (8h,
# primed by the pass-auto exec_cmd in hyprland.lua) is what avoids
# re-prompting.
#
# Hosts without the automation store (see common/pass/pass-auto) get the
# address only; the token is left to the CLI's own resolution order
# (VAULT_TOKEN/BAO_TOKEN in the environment, then ~/.vault-token or
# ~/.bao-token as written by `vault login` / `bao login`). That is what
# makes the same shim usable on hosts/server, which has no
# ~/.password-store-auto.
set -euo pipefail

# Builtins only (${0##*/} not basename, -ef not readlink -f): this runs
# before the real binary is located, so it must not depend on anything
# else being on PATH. A caller with a trimmed-down PATH should get the
# error below, not "basename: command not found".
NAME="${0##*/}"

# Find the real binary: first PATH entry named $NAME that isn't this shim.
# Resolved at call time rather than hardcoded, because the binary lives in
# /home/john/packages/vault on hosts/laptop and /usr/bin on hosts/server.
# -ef compares device+inode through symlinks, so the shim recognises
# itself under any of the names it is linked as, and cannot exec itself.
REAL=""
IFS=: read -ra PATH_DIRS <<< "$PATH"
for DIR in "${PATH_DIRS[@]}"; do
    CANDIDATE="$DIR/$NAME"
    [[ -f "$CANDIDATE" && -x "$CANDIDATE" ]] || continue
    [[ "$CANDIDATE" -ef "$0" ]] && continue
    REAL="$CANDIDATE"
    break
done

if [[ -z "$REAL" ]]; then
    echo "$NAME: no real '$NAME' binary on PATH (only this shim at $0)" >&2
    exit 127
fi

# Both names are set: openbao reads BAO_ADDR first and falls back to
# VAULT_ADDR, hashicorp vault reads only VAULT_ADDR, and non-CLI tooling
# in this repo reads VAULT_ADDR. An address already in the environment
# wins, so `VAULT_ADDR=... bao ...` still works for one-off targets.
export VAULT_ADDR="${VAULT_ADDR:-http://ifd-vault:8200}"
export BAO_ADDR="${BAO_ADDR:-$VAULT_ADDR}"

PASS_AUTO="$HOME/.local/bin/pass-auto"
if [[ -z "${VAULT_TOKEN:-}" && -z "${BAO_TOKEN:-}" && -x "$PASS_AUTO" ]]; then
    # Non-fatal: a missing entry or a cancelled pinentry should fall
    # through to the CLI's own token resolution, not abort the command.
    if TOKEN="$("$PASS_AUTO" show ifd-vault/token 2>/dev/null)" && [[ -n "$TOKEN" ]]; then
        export VAULT_TOKEN="$TOKEN"
        export BAO_TOKEN="$TOKEN"
    fi
fi

exec "$REAL" "$@"
